{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Countries",
  "description": "Schema for countries.json used by Flags Game",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "properties": {
      "code": {
        "type": "string",
        "pattern": "^[A-Z]{2}$",
        "description": "ISO 3166-1 alpha-2 country code (uppercase)"
      },
      "flag": {
        "type": "string",
        "description": "Emoji or short string representing the flag"
      },
      "names": {
        "type": "array",
        "items": { "type": "string" },
        "minItems": 1,
        "description": "List of accepted country names (localized variants)",
        "uniqueItems": true
      },
      "capitals": {
        "type": "array",
        "items": { "type": "string" },
        "minItems": 1,
        "description": "Preferred property for one-or-more capital names",
        "uniqueItems": true
      },
      "continent": {
        "type": "string",
        "description": "Continent name or region",
        "enum": ["africa", "asia", "europe", "north-america", "south-america"]
      }
    },
    "required": ["code", "flag", "names", "capitals"],
    "additionalProperties": true
  }
}
